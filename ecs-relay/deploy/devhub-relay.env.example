# devhub-relay.env.example —— 复制为 /etc/devhub-relay/env（权限 0600，属主 devhub-relay）
#
# 红线（约束 #13 / docs/19 §2.2）：本文件属用户外置凭据红线——绝不入仓库、绝不入日志/审计。
# 一次性注册码生成（部署机上执行）：openssl rand -hex 32
# 用途：relayClient 首装 POST /relay/host 换发 256-bit Relay 凭据（docs/19 §2.2）；
#       注册完成后可从本文件移除该项并重启（注册面随即关闭）。
RELAY_REGISTRATION_CODE=replace-with-openssl-rand-hex-32

# ---- RemoteWake（RW0，docs/18 §3.17）--------------------------------------
# relay 原生「唤醒 Windows」帧面（wake_host/wake_result）：树莓派经反向 SSH 隧道发 WoL。
# 缺省全关——不配置即 wake_host 恒回 disabled。
# systemd（devhub-relay.service）零变更：本文件即 EnvironmentFile，增行后
#   systemctl restart devhub-relay
# 即生效。执行命令依赖 ECS 机器级配置：~/.ssh/config 的 `pi` 别名
# （HostName 127.0.0.1 / Port 2222 / User / IdentityFile 全在别名层）+ Pi 侧
# wake-windows 远端命令（均已由用户建好）——本文件零凭据零端点字面量。
WAKE_ENABLED=0
WAKE_COMMAND=ssh pi wake-windows
WAKE_COOLDOWN_S=15
