  "meta": {
    "name": "devhub-relay-16-frame-fixture",
    "version": "1.0.0",
    "authority": "docs/18-ecs-relay-protocol.md §3（16 帧全表）",
    "purpose": "M2 三线契约一致性对拍（docs/20 §2.4/§5：R1 relay-client × R2 ecs-relay × R3 android-relay 同帧集双端解析一致，防漂移）",
    "createdAt": "2026-09-05",
    "directionLegend": "D→E=Android→ECS；E→D=ECS→Android；H→E=relayClient→ECS；E→H=ECS→relayClient",
    "conventions": {
      "eventFrameTypeResolution": "docs/18 §3.6 示例中 'type' 键出现两次（discriminator 'event' 与事件类型，JSON 重复键非法）。fixture 裁定：帧判别字段 type='event'（docs/18 §3.0 总表 #6 与 docs/19 §7.2 RelayCodec 帧清单的稳定判别面），事件类型承载于 'eventType' 字段（docs/14 原名，§4.1 改名的值语义保留）。R1/R3 对拍以此为准；契约修订须回 docs/18 广播（docs/20 §2.4）。",
      "tokenRotationRouting": "docs/18 §3.14 H→E token_rotation 帧形未含路由目标。R2 实现要求帧携带 'deviceId'（Windows 侧 remote_devices.id）以定位 relay_devices 行（sha256(newToken) 同步），否则回 BAD_PAYLOAD error 帧（见 ecs-relay/README.md 偏离单）。",
      "hostControlFrames": "16 帧集之外存在 host 腿控制帧 register_pairing / register_pairing_ack（docs/19 §4.5 pairingBridge：同步 {pairingId, code_hash, expiresAt} 给 ECS 落 pairing_codes），不属于 16 帧协议面、不入本 fixture 正集，见 frames 之外的 hostControlFrames 数组。",
      "redline": "样例中的 token/code/credential 均为占位符，真实凭据绝不入 fixture/日志/审计（约束 #13）"
    }
  },
