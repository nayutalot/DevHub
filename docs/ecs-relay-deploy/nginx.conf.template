# nginx.conf.template —— DevHub ECS Relay 无域名 IP TLS 反代模板（Caddy 版等价 nginx 实现，二选一）
#
# 用法：将 {TLS_DIR} 替换为 gen-ip-cert.sh 的 OUT_DIR（默认 /etc/devhub-relay/tls），
# 落到 /etc/nginx/sites-available/devhub-relay 并软链到 sites-enabled，`nginx -t && systemctl reload nginx`。
# 与 Caddyfile.template、docs/19 §5.6 形态一致：443 自签 IP 证书终结 → /relay/* WS 透传 + /v1/* REST
# → 127.0.0.1:8443（Relay 本体，不感知 TLS）。

# ---- HTTP/1.1 上游池（WS 升级必须 HTTP/1.1；等价 Caddy 裸 http:// 上游 / docs/19 `h12://` 语义）----
upstream devhub_relay_8443 {
    server 127.0.0.1:8443;
    keepalive 16;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name 59.110.149.11;

    # ---- 自签 IP 证书（SAN 必须含 IP:59.110.149.11 —— gen-ip-cert.sh 生成）----
    ssl_certificate     {TLS_DIR}/server.crt;
    ssl_certificate_key {TLS_DIR}/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:devhub_relay_ssl:10m;

    # ---- WebSocket 透传（device leg /relay/device、host leg /relay/host）----
    location /relay/ {
        proxy_pass http://devhub_relay_8443;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host       $host;
        # WS 长连：读超时要远大于应用层心跳周期（30s 心跳 + 余量）
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # ---- REST 面（docs/18 §7 五端点 + /v1/health）----
    location /v1/ {
        proxy_pass http://devhub_relay_8443;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # 其余路径一律 404（不放大暴露面）
    location / {
        return 404;
    }

    # 凭据红线（约束 #13）：access_log 默认不含请求头，禁止追加 $http_authorization
    access_log /var/log/nginx/devhub-relay-access.log;
}
